# Server-side only (Vercel env vars, read by api/). Never prefix them with VITE_:
# anything VITE_* ends up in the browser bundle.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# The station the dashboard opens with, when it is listed (devices.listed); else the first one.
STATION_DEVICE_ID=meteo-station-1
# Station coordinates, only for the Open-Meteo request (/api/sky), as JSON:
# {"<device_id>": [latitude, longitude], ...}. A station without them shows no sky.
# Never commit the real values.
STATION_COORDINATES={"meteo-station-1": [0, 0]}
