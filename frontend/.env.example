# Server-side only (Vercel env vars, read by api/). Never prefix them with VITE_:
# anything VITE_* ends up in the browser bundle.
# Self-hosted Supabase; the secret key is its service_role key.
SUPABASE_URL=https://<your-supabase>
SUPABASE_SECRET_KEY=
# The station the dashboard opens with, when it is listed (devices.listed); else the first one.
STATION_DEVICE_ID=meteo-station-1
# Station coordinates, only for the Open-Meteo requests (/api/sky, /api/forecast), as JSON:
# {"<device_id>": [latitude, longitude], ...}. A station without them shows no sky and no forecast.
# Never commit the real values.
STATION_COORDINATES={"meteo-station-1": [0, 0]}
# Daily forecast push (docs/superpowers/specs/2026-10-21-daily-forecast-push-design.md).
# VAPID keys: npx web-push generate-vapid-keys. The public one is public by design (the browser
# needs it), so it is the only VITE_ variable the server also reads.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared with Supabase Vault (name cron_secret): openssl rand -hex 32. Also keys the IP hashes.
CRON_SECRET=
