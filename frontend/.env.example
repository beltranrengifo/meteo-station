# Server-side only (Vercel env vars, read by api/). Never prefix them with VITE_:
# anything VITE_* ends up in the browser bundle.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Which station the public API serves: meteo-station-bench while testing, meteo-station-1 later.
STATION_DEVICE_ID=meteo-station-bench
# First local day with data (Europe/Madrid). Requests before it are rejected.
STATION_INSTALL_DATE=2026-10-08
