{
  "name": "meteo-station",
  "private": true,
  "scripts": {
    "dev": "pnpm -C frontend dev",
    "dev:api": "vercel dev --cwd frontend",
    "build": "pnpm -C frontend build",
    "test": "pnpm -C frontend test",
    "typecheck": "pnpm -C frontend typecheck",
    "gen:types": "pnpm -C frontend gen:types",
    "firmware": "deno run -q --no-lock --node-modules-dir=none --allow-read --allow-net --allow-env --allow-run=pio,$HOME/.platformio/penv/bin/pio --env-file=backend/.env.local backend/scripts/firmware.ts",
    "station": "deno run -q --no-lock --node-modules-dir=none --allow-net --allow-env --env-file=backend/.env.local backend/scripts/station.ts"
  }
}
